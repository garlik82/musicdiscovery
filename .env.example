# ============================================================
# PlexDiscover - Variáveis de Ambiente de Exemplo
# ============================================================
# Copia este ficheiro para .env e preenche com os teus valores:
# cp .env.example .env

# --- Plex Media Server ---
# URL e Token da tua conta/servidor Plex
PLEX_URL=http://<IP_DO_TEU_PLEX>:32400
PLEX_TOKEN=teu_plex_token_aqui

# --- Last.fm ---
# Chave de API Last.fm (gratuita em https://www.last.fm/api/account/create)
LASTFM_API_KEY=tua_api_key_do_lastfm
LASTFM_USERNAME=teu_username_do_lastfm

# --- slskd (Soulseek Daemon) ---
# Endpoint e chave de API do teu slskd
SLSKD_URL=http://<IP_DO_TEU_SLSKD>:5030
SLSKD_API_KEY=tua_api_key_do_slskd

# --- Pastas de Armazenamento no Host ---
# Pasta onde o slskd conclui os downloads
DOWNLOADS_PATH=/volume1/Media/Downloads/complete

# Biblioteca de música permanente (intocável pelo sistema)
MUSIC_PATH=/volume1/Media/Music

# Biblioteca temporária dedicada de descoberta
DISCOVERY_PATH=/volume1/Media/Misc/MusicDiscovery
